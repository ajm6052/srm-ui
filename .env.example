# Base URL of the SRM Go REST API. Defaults to the local server's port when unset.
VITE_API_BASE_URL=http://localhost:2020

# --- Auth ---
# Auth mode the UI uses:
#   dev      (default) no Cognito — the login form takes just an email, sent as the
#            bearer to the API running with AUTH_DISABLED (local dev only).
#   cognito  AWS Amplify signs in against the Cognito user pool and sends the ID
#            token to the API.
VITE_AUTH_MODE=dev

# --- AWS Cognito / Amplify (only when VITE_AUTH_MODE=cognito) ---
# Public SPA app client (no secret; safe to ship in the bundle). Same pool the API
# verifies tokens against (COGNITO_* on the backend).
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_USER_POOL_CLIENT_ID=
