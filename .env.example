# Base URL of the SRM Go REST API. Defaults to the local server's port when unset.
VITE_API_BASE_URL=http://localhost:2020

# --- Auth ---
# Which login flow the UI uses:
#   local    (default) email + password posted to the API's /auth/login
#   cognito  AWS Amplify authenticates against Cognito on the login route
VITE_AUTH_PROVIDER=local

# --- AWS Cognito / Amplify (only when VITE_AUTH_PROVIDER=cognito) ---
# Amplify Auth config for the login route. These are public client identifiers
# (safe to ship in the bundle); Cognito owns the credentials.
VITE_AWS_REGION=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_APP_CLIENT_ID=
# Optional: Hosted UI domain if using redirect/social sign-in
VITE_COGNITO_DOMAIN=
