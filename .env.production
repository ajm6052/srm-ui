# Baked into the bundle at build time (vite build) — must be the public API
# origin, never localhost.
VITE_API_BASE_URL=https://api.srm.ajmendoza.dev

# Auth mode. 'cognito' signs in via AWS Amplify against the pool below and sends
# the Cognito ID token to the API. (The dev bypass mode is 'dev' — never in prod.)
VITE_AUTH_MODE=cognito

# AWS Cognito public SPA app client (no secret). Same pool the API verifies against.
VITE_COGNITO_USER_POOL_ID=us-east-1_X7gMOxqkK
VITE_COGNITO_USER_POOL_CLIENT_ID=2a2m0gf5jq6asln9kd1fi138bm
