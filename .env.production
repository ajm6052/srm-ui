# Baked into the bundle at build time (vite build) — must be the public API
# origin, never localhost.
VITE_API_BASE_URL=https://api.srm.ajmendoza.dev

# SRM uses self-contained JWT auth today (email + password to /auth/login). When
# it moves to Cognito (Amplify on the login route), set this to `cognito` and fill
# the public client ids below.
VITE_AUTH_PROVIDER=local

# AWS Cognito public SPA client (no secret) — only read when VITE_AUTH_PROVIDER=cognito.
VITE_AWS_REGION=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_APP_CLIENT_ID=
